# SecureFix AI Backend Environment Configuration Example

PROJECT_NAME="SecureFix AI"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174"]

# Supabase Auth (required for protected endpoints) - Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / publishable key - used only to ask Supabase whether a user's email is confirmed
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Project Settings > API > JWT Settings > JWT Secret.
# Only needed if the project still signs tokens with the legacy HS256 secret.
# Projects using asymmetric JWT signing keys are verified through the public JWKS endpoint instead.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
