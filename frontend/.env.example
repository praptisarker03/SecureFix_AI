# Supabase Configuration for Frontend (Vite)
# Replace these with your actual Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# FastAPI backend base URL (used to send the Supabase access token for server-side checks)
VITE_API_URL=http://localhost:8000
